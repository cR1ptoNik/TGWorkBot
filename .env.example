# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Telegram WebApp public URL (e.g. Cloudflare Tunnel, ngrok, or server domain)
WEBAPP_URL=https://your-public-tunnel-url.trycloudflare.com

# Node server URL for python bot API sync (defaults to http://localhost:3000)
SERVER_URL=http://localhost:3000

# Optional: Path to Tesseract binary if not in PATH (e.g. /usr/bin/tesseract or C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=tesseract

# Gemini API Key (Optional for AI analysis)
GEMINI_API_KEY=
